# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes no Vercel (Settings > Environment Variables).
# NUNCA coloque chaves reais neste arquivo nem no repositório.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ficar no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave SECRETA (service_role). Somente servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Primeiro acesso: palavra secreta para criar o primeiro administrador em /setup (apague depois de usar).
SETUP_TOKEN=

# Formulário da landing (/api/leads)
ALLOWED_ORIGINS=*
LEAD_IP_SALT=troque-por-um-texto-aleatorio
# Opcional: anti-robô Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
